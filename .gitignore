# State holds the CA private key, the Gateway leaf private key, and the connector
# tokens in plaintext. Never commit it.
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
terraform.tfvars
*.tfplan
tf.plan

# Exported CA cert, if you dump it for a browser
*.pem

# SSH CA public key, written by terraform apply for Compose to mount
ssh-ca.pub

# Replayed SSH sessions. They hold everything typed and shown in the session.
*.cast

# Written by terraform apply in docker/. Holds your network name and the Compose
# profiles to start.
.env

.DS_Store