twingate:
  network: ${network}

port: ${port}
metricsPort: ${metrics_port}

tls:
  certificates:
    files:
      - certificateFile: /etc/gateway/tls.crt
        privateKeyFile: /etc/gateway/tls.key

# Injected into every proxied request.
webApp:
  requestHeaders: ${jsonencode(request_headers)}

ssh:
  gateway:
    # Every session logs in upstream as this account.
    username: ${ssh_username}
    key:
      type: ed25519
    # Presented to SSH clients.
    hostCertificate:
      ttl: 24h
    # Presented to SSH servers. Minted per connection, so it can be short.
    userCertificate:
      ttl: 5m
  ca:
    local:
      privateKeyFile: /etc/gateway/ssh-ca.key
