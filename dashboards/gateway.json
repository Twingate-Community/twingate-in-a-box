          },
          "editorMode": "code",
          "expr": "sum(rate(twingate_gateway_http_request_size_bytes_sum[$__rate_interval]))",
          "legendFormat": "in",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(twingate_gateway_http_response_size_bytes_sum[$__rate_interval]))",
          "legendFormat": "out",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests by transport",
      "datasource": {
